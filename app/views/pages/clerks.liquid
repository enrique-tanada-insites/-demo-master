---
slug: clerks
---
{% raw %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Clerks</title>
  <script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.prod.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #f0f2f5;
      color: #1a1a2e;
      min-height: 100vh;
    }

    .sidebar {
      position: fixed;
      top: 0; left: 0;
      width: 220px;
      height: 100vh;
      background: #1a1a2e;
      padding: 32px 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .sidebar-logo {
      font-size: 18px;
      font-weight: 700;
      color: #fff;
      padding: 0 12px 24px;
      letter-spacing: -0.3px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      border-radius: 8px;
      font-size: 14px;
      color: #8892a4;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
      text-decoration: none;
    }

    .nav-item:hover, .nav-item.active {
      background: #ffffff14;
      color: #fff;
    }

    .nav-item .icon { font-size: 16px; }

    .main {
      margin-left: 220px;
      padding: 40px;
      min-height: 100vh;
    }

    .page-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 32px;
    }

    .page-title {
      font-size: 24px;
      font-weight: 700;
      color: #1a1a2e;
    }

    .page-subtitle {
      font-size: 14px;
      color: #6b7280;
      margin-top: 2px;
    }

    .toolbar {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .search-wrap { position: relative; }

    .search-wrap .icon {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: #9ca3af;
      font-size: 14px;
      pointer-events: none;
    }

    .search-input {
      padding: 8px 12px 8px 34px;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      font-size: 14px;
      color: #1a1a2e;
      background: #fff;
      width: 240px;
      outline: none;
      transition: border-color 0.15s;
    }

    .search-input:focus { border-color: #4f46e5; }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      border: none;
      transition: background 0.15s;
    }

    .btn-primary { background: #4f46e5; color: #fff; }
    .btn-primary:hover { background: #4338ca; }

    .card {
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 1px 3px rgba(0,0,0,.06);
      overflow: hidden;
    }

    table { width: 100%; border-collapse: collapse; }

    thead th {
      padding: 12px 20px;
      text-align: left;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #9ca3af;
      background: #f9fafb;
      border-bottom: 1px solid #f3f4f6;
      cursor: pointer;
      user-select: none;
      white-space: nowrap;
    }

    thead th:hover { color: #4f46e5; }

    thead th .sort-icon {
      display: inline-block;
      margin-left: 4px;
      opacity: 0.4;
      font-size: 10px;
    }

    thead th.sorted .sort-icon { opacity: 1; color: #4f46e5; }

    tbody tr {
      border-bottom: 1px solid #f3f4f6;
      transition: background 0.1s;
    }

    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: #f9fafb; }

    td {
      padding: 14px 20px;
      font-size: 14px;
      color: #374151;
      vertical-align: middle;
    }

    .user-cell {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 600;
      color: #fff;
      flex-shrink: 0;
    }

    .user-name {
      font-weight: 500;
      color: #1a1a2e;
      font-size: 14px;
    }

    .user-email {
      font-size: 12px;
      color: #9ca3af;
      margin-top: 1px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 500;
    }

    .badge-active   { background: #d1fae5; color: #065f46; }
    .badge-inactive { background: #f3f4f6; color: #6b7280; }
    .badge-on-leave { background: #fef3c7; color: #92400e; }

    .dept-badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 10px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 500;
      background: #ede9fe;
      color: #5b21b6;
    }

    .dept-badge.front-desk  { background: #dbeafe; color: #1e40af; }
    .dept-badge.records     { background: #fce7f3; color: #9d174d; }
    .dept-badge.billing     { background: #dcfce7; color: #166534; }
    .dept-badge.support     { background: #fff7ed; color: #9a3412; }

    .action-btn {
      background: none;
      border: none;
      cursor: pointer;
      color: #9ca3af;
      font-size: 16px;
      padding: 4px 6px;
      border-radius: 4px;
      transition: background 0.1s, color 0.1s;
    }

    .action-btn:hover { background: #f3f4f6; color: #4f46e5; }

    .table-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 20px;
      border-top: 1px solid #f3f4f6;
      font-size: 13px;
      color: #6b7280;
    }

    .pagination { display: flex; gap: 4px; }

    .page-btn {
      width: 30px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 6px;
      border: 1px solid #e5e7eb;
      font-size: 13px;
      cursor: pointer;
      background: #fff;
      color: #374151;
      transition: background 0.1s, border-color 0.1s;
    }

    .page-btn:hover { background: #f3f4f6; }
    .page-btn.active { background: #4f46e5; border-color: #4f46e5; color: #fff; }
    .page-btn:disabled { opacity: 0.4; cursor: default; }

    .empty {
      padding: 60px 20px;
      text-align: center;
      color: #9ca3af;
      font-size: 14px;
    }
  </style>
</head>
<body>
  <div id="app">
    <aside class="sidebar">
      <div class="sidebar-logo">&#9670; Analytics</div>
      <a href="/dashboard" class="nav-item"><span class="icon">&#9632;</span> Dashboard</a>
      <a href="/reports"   class="nav-item"><span class="icon">&#9675;</span> Reports</a>
      <a href="/members"   class="nav-item"><span class="icon">&#9651;</span> Members</a>
      <a href="/clerks"    class="nav-item active"><span class="icon">&#9670;</span> Clerks</a>
      <a href="/settings"  class="nav-item"><span class="icon">&#9670;</span> Settings</a>
    </aside>

    <main class="main">
      <div class="page-header">
        <div>
          <div class="page-title">Clerks</div>
          <div class="page-subtitle">{{ filteredClerks.length }} clerk{{ filteredClerks.length !== 1 ? 's' : '' }} found</div>
        </div>
        <div class="toolbar">
          <div class="search-wrap">
            <span class="icon">&#9906;</span>
            <input
              class="search-input"
              v-model="search"
              placeholder="Search clerks…"
              type="text"
            />
          </div>
          <button class="btn btn-primary">+ Add Clerk</button>
        </div>
      </div>

      <div class="card">
        <table>
          <thead>
            <tr>
              <th @click="sortBy('name')" :class="{ sorted: sortKey === 'name' }">
                Clerk <span class="sort-icon">{{ sortKey === 'name' ? (sortDir === 'asc' ? '▲' : '▼') : '⇅' }}</span>
              </th>
              <th @click="sortBy('employeeId')" :class="{ sorted: sortKey === 'employeeId' }">
                Employee ID <span class="sort-icon">{{ sortKey === 'employeeId' ? (sortDir === 'asc' ? '▲' : '▼') : '⇅' }}</span>
              </th>
              <th @click="sortBy('department')" :class="{ sorted: sortKey === 'department' }">
                Department <span class="sort-icon">{{ sortKey === 'department' ? (sortDir === 'asc' ? '▲' : '▼') : '⇅' }}</span>
              </th>
              <th @click="sortBy('branch')" :class="{ sorted: sortKey === 'branch' }">
                Branch <span class="sort-icon">{{ sortKey === 'branch' ? (sortDir === 'asc' ? '▲' : '▼') : '⇅' }}</span>
              </th>
              <th @click="sortBy('status')" :class="{ sorted: sortKey === 'status' }">
                Status <span class="sort-icon">{{ sortKey === 'status' ? (sortDir === 'asc' ? '▲' : '▼') : '⇅' }}</span>
              </th>
              <th @click="sortBy('lastShift')" :class="{ sorted: sortKey === 'lastShift' }">
                Last Shift <span class="sort-icon">{{ sortKey === 'lastShift' ? (sortDir === 'asc' ? '▲' : '▼') : '⇅' }}</span>
              </th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <tr v-if="pagedClerks.length === 0">
              <td colspan="7"><div class="empty">No clerks match your search.</div></td>
            </tr>
            <tr v-for="clerk in pagedClerks" :key="clerk.id">
              <td>
                <div class="user-cell">
                  <div class="avatar" :style="{ background: clerk.color }">{{ initials(clerk.name) }}</div>
                  <div>
                    <div class="user-name">{{ clerk.name }}</div>
                    <div class="user-email">{{ clerk.email }}</div>
                  </div>
                </div>
              </td>
              <td>{{ clerk.employeeId }}</td>
              <td><span class="dept-badge" :class="clerk.deptClass">{{ clerk.department }}</span></td>
              <td>{{ clerk.branch }}</td>
              <td><span class="badge" :class="'badge-' + clerk.statusClass">{{ clerk.status }}</span></td>
              <td>{{ clerk.lastShift }}</td>
              <td>
                <button class="action-btn" title="Edit">&#9998;</button>
                <button class="action-btn" title="Delete">&#10006;</button>
              </td>
            </tr>
          </tbody>
        </table>

        <div class="table-footer">
          <span>Showing {{ pageStart }}–{{ pageEnd }} of {{ filteredClerks.length }}</span>
          <div class="pagination">
            <button class="page-btn" :disabled="page === 1" @click="page--">&#8249;</button>
            <button
              v-for="p in totalPages" :key="p"
              class="page-btn" :class="{ active: p === page }"
              @click="page = p"
            >{{ p }}</button>
            <button class="page-btn" :disabled="page === totalPages" @click="page++">&#8250;</button>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const { createApp, ref, computed } = Vue;

    const COLORS = ['#4f46e5','#0891b2','#059669','#d97706','#dc2626','#7c3aed','#db2777','#0284c7'];

    const CLERKS = [
      { id:1,  name:'Anna Rivera',     email:'anna.r@example.com',    employeeId:'CLK-001', department:'Front Desk', deptClass:'front-desk', branch:'Main Office',    status:'Active',   statusClass:'active',   lastShift:'Today' },
      { id:2,  name:'Ben Nguyen',      email:'ben.n@example.com',     employeeId:'CLK-002', department:'Records',    deptClass:'records',    branch:'North Branch',   status:'Active',   statusClass:'active',   lastShift:'Yesterday' },
      { id:3,  name:'Clara Santos',    email:'clara.s@example.com',   employeeId:'CLK-003', department:'Billing',    deptClass:'billing',    branch:'South Branch',   status:'On Leave', statusClass:'on-leave',  lastShift:'Apr 10, 2026' },
      { id:4,  name:'Daniel Park',     email:'daniel.p@example.com',  employeeId:'CLK-004', department:'Support',    deptClass:'support',    branch:'Main Office',    status:'Active',   statusClass:'active',   lastShift:'Today' },
      { id:5,  name:'Elena Moreira',   email:'elena.m@example.com',   employeeId:'CLK-005', department:'Front Desk', deptClass:'front-desk', branch:'East Branch',    status:'Inactive', statusClass:'inactive',  lastShift:'Mar 28, 2026' },
      { id:6,  name:'Felix Okafor',    email:'felix.o@example.com',   employeeId:'CLK-006', department:'Records',    deptClass:'records',    branch:'Main Office',    status:'Active',   statusClass:'active',   lastShift:'Today' },
      { id:7,  name:'Grace Yamamoto',  email:'grace.y@example.com',   employeeId:'CLK-007', department:'Billing',    deptClass:'billing',    branch:'West Branch',    status:'Active',   statusClass:'active',   lastShift:'2 hours ago' },
      { id:8,  name:'Hugo Fernandez',  email:'hugo.f@example.com',    employeeId:'CLK-008', department:'Support',    deptClass:'support',    branch:'North Branch',   status:'On Leave', statusClass:'on-leave',  lastShift:'Apr 5, 2026' },
      { id:9,  name:'Iris Chen',       email:'iris.c@example.com',    employeeId:'CLK-009', department:'Front Desk', deptClass:'front-desk', branch:'South Branch',   status:'Active',   statusClass:'active',   lastShift:'Today' },
      { id:10, name:'Jake Morrison',   email:'jake.m@example.com',    employeeId:'CLK-010', department:'Records',    deptClass:'records',    branch:'East Branch',    status:'Active',   statusClass:'active',   lastShift:'Yesterday' },
      { id:11, name:'Kira Patel',      email:'kira.p@example.com',    employeeId:'CLK-011', department:'Billing',    deptClass:'billing',    branch:'Main Office',    status:'Inactive', statusClass:'inactive',  lastShift:'Feb 20, 2026' },
      { id:12, name:'Leo Andrade',     email:'leo.a@example.com',     employeeId:'CLK-012', department:'Support',    deptClass:'support',    branch:'West Branch',    status:'Active',   statusClass:'active',   lastShift:'3 hours ago' },
    ].map((c, i) => ({ ...c, color: COLORS[i % COLORS.length] }));

    const PER_PAGE = 8;

    createApp({
      setup() {
        const search  = ref('');
        const sortKey = ref('name');
        const sortDir = ref('asc');
        const page    = ref(1);

        function initials(name) {
          return name.split(' ').map(w => w[0]).slice(0, 2).join('').toUpperCase();
        }

        function sortBy(key) {
          if (sortKey.value === key) {
            sortDir.value = sortDir.value === 'asc' ? 'desc' : 'asc';
          } else {
            sortKey.value = key;
            sortDir.value = 'asc';
          }
          page.value = 1;
        }

        const filteredClerks = computed(() => {
          const q = search.value.toLowerCase();
          const list = q
            ? CLERKS.filter(c =>
                c.name.toLowerCase().includes(q) ||
                c.email.toLowerCase().includes(q) ||
                c.department.toLowerCase().includes(q) ||
                c.branch.toLowerCase().includes(q) ||
                c.employeeId.toLowerCase().includes(q)
              )
            : [...CLERKS];

          list.sort((a, b) => {
            const av = a[sortKey.value] ?? '';
            const bv = b[sortKey.value] ?? '';
            return sortDir.value === 'asc' ? av.localeCompare(bv) : bv.localeCompare(av);
          });
          return list;
        });

        const totalPages = computed(() => Math.max(1, Math.ceil(filteredClerks.value.length / PER_PAGE)));

        const pagedClerks = computed(() => {
          const start = (page.value - 1) * PER_PAGE;
          return filteredClerks.value.slice(start, start + PER_PAGE);
        });

        const pageStart = computed(() => filteredClerks.value.length === 0 ? 0 : (page.value - 1) * PER_PAGE + 1);
        const pageEnd   = computed(() => Math.min(page.value * PER_PAGE, filteredClerks.value.length));

        return { search, sortKey, sortDir, page, filteredClerks, pagedClerks, totalPages, pageStart, pageEnd, initials, sortBy };
      },
    }).mount('#app');
  </script>
</body>
</html>
{% endraw %}
