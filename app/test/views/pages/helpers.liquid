---
slug: helpers
---
{% raw %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Helpers</title>
  <script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.prod.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #f0f2f5;
      color: #1a1a2e;
      min-height: 100vh;
    }

    .sidebar {
      position: fixed;
      top: 0; left: 0;
      width: 220px;
      height: 100vh;
      background: #1a1a2e;
      padding: 32px 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .sidebar-logo {
      font-size: 18px;
      font-weight: 700;
      color: #fff;
      padding: 0 12px 24px;
      letter-spacing: -0.3px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      border-radius: 8px;
      font-size: 14px;
      color: #8892a4;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
      text-decoration: none;
    }

    .nav-item:hover, .nav-item.active {
      background: #ffffff14;
      color: #fff;
    }

    .nav-item .icon { font-size: 16px; }

    .main {
      margin-left: 220px;
      padding: 40px;
      min-height: 100vh;
    }

    .page-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 32px;
    }

    .page-title {
      font-size: 24px;
      font-weight: 700;
      color: #1a1a2e;
    }

    .page-subtitle {
      font-size: 14px;
      color: #6b7280;
      margin-top: 2px;
    }

    .toolbar {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .search-wrap {
      position: relative;
    }

    .search-wrap .icon {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: #9ca3af;
      font-size: 14px;
      pointer-events: none;
    }

    .search-input {
      padding: 8px 12px 8px 34px;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      font-size: 14px;
      color: #1a1a2e;
      background: #fff;
      width: 240px;
      outline: none;
      transition: border-color 0.15s;
    }

    .search-input:focus { border-color: #4f46e5; }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      border: none;
      transition: background 0.15s;
    }

    .btn-primary { background: #4f46e5; color: #fff; }
    .btn-primary:hover { background: #4338ca; }

    .card {
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 1px 3px rgba(0,0,0,.06);
      overflow: hidden;
    }

    table { width: 100%; border-collapse: collapse; }

    thead th {
      padding: 12px 20px;
      text-align: left;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #9ca3af;
      background: #f9fafb;
      border-bottom: 1px solid #f3f4f6;
      cursor: pointer;
      user-select: none;
      white-space: nowrap;
    }

    thead th:hover { color: #4f46e5; }

    thead th .sort-icon {
      display: inline-block;
      margin-left: 4px;
      opacity: 0.4;
      font-size: 10px;
    }

    thead th.sorted .sort-icon { opacity: 1; color: #4f46e5; }

    tbody tr {
      border-bottom: 1px solid #f3f4f6;
      transition: background 0.1s;
    }

    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: #f9fafb; }

    td {
      padding: 14px 20px;
      font-size: 14px;
      color: #374151;
      vertical-align: middle;
    }

    .user-cell {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 600;
      color: #fff;
      flex-shrink: 0;
    }

    .user-name {
      font-weight: 500;
      color: #1a1a2e;
      font-size: 14px;
    }

    .user-email {
      font-size: 12px;
      color: #9ca3af;
      margin-top: 1px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 500;
    }

    .badge-available   { background: #d1fae5; color: #065f46; }
    .badge-busy        { background: #fef3c7; color: #92400e; }
    .badge-offline     { background: #f3f4f6; color: #6b7280; }

    .skill-tag {
      display: inline-flex;
      align-items: center;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 500;
      background: #ede9fe;
      color: #5b21b6;
      margin-right: 4px;
      margin-bottom: 2px;
    }

    .rating {
      display: flex;
      align-items: center;
      gap: 2px;
      font-size: 13px;
      color: #f59e0b;
    }

    .rating span {
      color: #6b7280;
      font-size: 12px;
      margin-left: 4px;
    }

    .action-btn {
      background: none;
      border: none;
      cursor: pointer;
      color: #9ca3af;
      font-size: 16px;
      padding: 4px 6px;
      border-radius: 4px;
      transition: background 0.1s, color 0.1s;
    }

    .action-btn:hover { background: #f3f4f6; color: #4f46e5; }

    .table-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 20px;
      border-top: 1px solid #f3f4f6;
      font-size: 13px;
      color: #6b7280;
    }

    .pagination { display: flex; gap: 4px; }

    .page-btn {
      width: 30px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 6px;
      border: 1px solid #e5e7eb;
      font-size: 13px;
      cursor: pointer;
      background: #fff;
      color: #374151;
      transition: background 0.1s, border-color 0.1s;
    }

    .page-btn:hover { background: #f3f4f6; }
    .page-btn.active { background: #4f46e5; border-color: #4f46e5; color: #fff; }
    .page-btn:disabled { opacity: 0.4; cursor: default; }

    .empty {
      padding: 60px 20px;
      text-align: center;
      color: #9ca3af;
      font-size: 14px;
    }
  </style>
</head>
<body>
  <div id="app">
    <aside class="sidebar">
      <div class="sidebar-logo">&#9670; Analytics</div>
      <a href="/dashboard" class="nav-item"><span class="icon">&#9632;</span> Dashboard</a>
      <a href="/reports"   class="nav-item"><span class="icon">&#9675;</span> Reports</a>
      <a href="/members"   class="nav-item"><span class="icon">&#9651;</span> Members</a>
      <a href="/helpers"   class="nav-item active"><span class="icon">&#9670;</span> Helpers</a>
      <a href="/drivers"   class="nav-item"><span class="icon">&#9654;</span> Drivers</a>
      <a href="/settings"  class="nav-item"><span class="icon">&#9881;</span> Settings</a>
    </aside>

    <main class="main">
      <div class="page-header">
        <div>
          <div class="page-title">Helpers</div>
          <div class="page-subtitle">{{ filteredHelpers.length }} helper{{ filteredHelpers.length !== 1 ? 's' : '' }} found</div>
        </div>
        <div class="toolbar">
          <div class="search-wrap">
            <span class="icon">&#9906;</span>
            <input
              class="search-input"
              v-model="search"
              placeholder="Search helpers…"
              type="text"
            />
          </div>
          <button class="btn btn-primary">+ Add Helper</button>
        </div>
      </div>

      <div class="card">
        <table>
          <thead>
            <tr>
              <th @click="sortBy('name')" :class="{ sorted: sortKey === 'name' }">
                Helper <span class="sort-icon">{{ sortKey === 'name' ? (sortDir === 'asc' ? '▲' : '▼') : '⇅' }}</span>
              </th>
              <th @click="sortBy('specialty')" :class="{ sorted: sortKey === 'specialty' }">
                Specialty <span class="sort-icon">{{ sortKey === 'specialty' ? (sortDir === 'asc' ? '▲' : '▼') : '⇅' }}</span>
              </th>
              <th @click="sortBy('status')" :class="{ sorted: sortKey === 'status' }">
                Status <span class="sort-icon">{{ sortKey === 'status' ? (sortDir === 'asc' ? '▲' : '▼') : '⇅' }}</span>
              </th>
              <th @click="sortBy('tasksCompleted')" :class="{ sorted: sortKey === 'tasksCompleted' }">
                Tasks Done <span class="sort-icon">{{ sortKey === 'tasksCompleted' ? (sortDir === 'asc' ? '▲' : '▼') : '⇅' }}</span>
              </th>
              <th @click="sortBy('rating')" :class="{ sorted: sortKey === 'rating' }">
                Rating <span class="sort-icon">{{ sortKey === 'rating' ? (sortDir === 'asc' ? '▲' : '▼') : '⇅' }}</span>
              </th>
              <th @click="sortBy('joinedDate')" :class="{ sorted: sortKey === 'joinedDate' }">
                Joined <span class="sort-icon">{{ sortKey === 'joinedDate' ? (sortDir === 'asc' ? '▲' : '▼') : '⇅' }}</span>
              </th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <tr v-if="pagedHelpers.length === 0">
              <td colspan="7"><div class="empty">No helpers match your search.</div></td>
            </tr>
            <tr v-for="helper in pagedHelpers" :key="helper.id">
              <td>
                <div class="user-cell">
                  <div class="avatar" :style="{ background: helper.color }">{{ initials(helper.name) }}</div>
                  <div>
                    <div class="user-name">{{ helper.name }}</div>
                    <div class="user-email">{{ helper.email }}</div>
                  </div>
                </div>
              </td>
              <td>
                <div>
                  <span v-for="skill in helper.skills" :key="skill" class="skill-tag">{{ skill }}</span>
                </div>
              </td>
              <td><span class="badge" :class="'badge-' + helper.status.toLowerCase()">{{ helper.status }}</span></td>
              <td>{{ helper.tasksCompleted }}</td>
              <td>
                <div class="rating">
                  ★★★★★
                  <span>({{ helper.rating }})</span>
                </div>
              </td>
              <td>{{ helper.joinedDate }}</td>
              <td>
                <button class="action-btn" title="Edit">&#9998;</button>
                <button class="action-btn" title="Delete">&#10006;</button>
              </td>
            </tr>
          </tbody>
        </table>

        <div class="table-footer">
          <span>Showing {{ pageStart }}–{{ pageEnd }} of {{ filteredHelpers.length }}</span>
          <div class="pagination">
            <button class="page-btn" :disabled="page === 1" @click="page--">&#8249;</button>
            <button
              v-for="p in totalPages" :key="p"
              class="page-btn" :class="{ active: p === page }"
              @click="page = p"
            >{{ p }}</button>
            <button class="page-btn" :disabled="page === totalPages" @click="page++">&#8250;</button>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const { createApp, ref, computed } = Vue;

    const COLORS = ['#4f46e5','#0891b2','#059669','#d97706','#dc2626','#7c3aed','#db2777','#0284c7'];

    const HELPERS = [
      { id:1,  name:'Sophia Turner',   email:'sophia@example.com',  specialty:'Support',    skills:['Chat','Email'],          status:'Available', tasksCompleted:142, rating:'4.9', joinedDate:'Jan 10, 2024' },
      { id:2,  name:'Noah Patel',      email:'noah@example.com',    specialty:'Technical',  skills:['Coding','Debug'],        status:'Busy',      tasksCompleted:98,  rating:'4.7', joinedDate:'Feb 3, 2024'  },
      { id:3,  name:'Emma Clarke',     email:'emma@example.com',    specialty:'Logistics',  skills:['Planning','Tracking'],   status:'Available', tasksCompleted:215, rating:'5.0', joinedDate:'Jan 22, 2024' },
      { id:4,  name:'Luca Romano',     email:'luca@example.com',    specialty:'Finance',    skills:['Billing','Reports'],     status:'Offline',   tasksCompleted:77,  rating:'4.5', joinedDate:'Mar 8, 2024'  },
      { id:5,  name:'Mia Johnson',     email:'mia@example.com',     specialty:'Support',    skills:['Chat','Phone'],          status:'Available', tasksCompleted:189, rating:'4.8', joinedDate:'Feb 17, 2024' },
      { id:6,  name:'Ethan Brooks',    email:'ethan@example.com',   specialty:'Technical',  skills:['API','DevOps'],          status:'Busy',      tasksCompleted:64,  rating:'4.6', joinedDate:'Apr 5, 2024'  },
      { id:7,  name:'Olivia Harris',   email:'olivia@example.com',  specialty:'Logistics',  skills:['Dispatch','Routing'],    status:'Available', tasksCompleted:301, rating:'4.9', joinedDate:'Jan 5, 2024'  },
      { id:8,  name:'James Nguyen',    email:'james@example.com',   specialty:'Finance',    skills:['Invoicing','Audits'],    status:'Available', tasksCompleted:130, rating:'4.7', joinedDate:'Mar 30, 2024' },
      { id:9,  name:'Ava Mitchell',    email:'ava@example.com',     specialty:'Support',    skills:['Email','Escalations'],   status:'Offline',   tasksCompleted:55,  rating:'4.4', joinedDate:'May 14, 2024' },
      { id:10, name:'William Foster',  email:'will@example.com',    specialty:'Technical',  skills:['QA','Testing'],          status:'Available', tasksCompleted:178, rating:'4.8', joinedDate:'Feb 28, 2024' },
      { id:11, name:'Isabella Reed',   email:'bella@example.com',   specialty:'Logistics',  skills:['Inventory','Shipping'],  status:'Busy',      tasksCompleted:92,  rating:'4.6', joinedDate:'Apr 19, 2024' },
      { id:12, name:'Mason Price',     email:'mason@example.com',   specialty:'Finance',    skills:['Payroll','Tax'],         status:'Available', tasksCompleted:163, rating:'4.7', joinedDate:'Mar 12, 2024' },
    ].map((h, i) => ({ ...h, color: COLORS[i % COLORS.length] }));

    const PER_PAGE = 8;

    createApp({
      setup() {
        const search  = ref('');
        const sortKey = ref('name');
        const sortDir = ref('asc');
        const page    = ref(1);

        function initials(name) {
          return name.split(' ').map(w => w[0]).slice(0, 2).join('').toUpperCase();
        }

        function sortBy(key) {
          if (sortKey.value === key) {
            sortDir.value = sortDir.value === 'asc' ? 'desc' : 'asc';
          } else {
            sortKey.value = key;
            sortDir.value = 'asc';
          }
          page.value = 1;
        }

        const filteredHelpers = computed(() => {
          const q = search.value.toLowerCase();
          const list = q
            ? HELPERS.filter(h =>
                h.name.toLowerCase().includes(q) ||
                h.email.toLowerCase().includes(q) ||
                h.specialty.toLowerCase().includes(q) ||
                h.skills.some(s => s.toLowerCase().includes(q))
              )
            : [...HELPERS];

          list.sort((a, b) => {
            const av = a[sortKey.value] ?? '';
            const bv = b[sortKey.value] ?? '';
            if (typeof av === 'number') {
              return sortDir.value === 'asc' ? av - bv : bv - av;
            }
            return sortDir.value === 'asc' ? String(av).localeCompare(String(bv)) : String(bv).localeCompare(String(av));
          });
          return list;
        });

        const totalPages = computed(() => Math.max(1, Math.ceil(filteredHelpers.value.length / PER_PAGE)));

        const pagedHelpers = computed(() => {
          const start = (page.value - 1) * PER_PAGE;
          return filteredHelpers.value.slice(start, start + PER_PAGE);
        });

        const pageStart = computed(() => filteredHelpers.value.length === 0 ? 0 : (page.value - 1) * PER_PAGE + 1);
        const pageEnd   = computed(() => Math.min(page.value * PER_PAGE, filteredHelpers.value.length));

        return { search, sortKey, sortDir, page, filteredHelpers, pagedHelpers, totalPages, pageStart, pageEnd, initials, sortBy };
      },
    }).mount('#app');
  </script>
</body>
</html>
{% endraw %}